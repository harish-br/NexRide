rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write their own user profile
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Users can create trips and read their own trips
    match /trips/{tripId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null
                           && resource.data.userId == request.auth.uid;
    }

    // Users can ONLY read driverRequests (not write)
    match /driverRequests/{driverId}/trips/{tripId} {
      allow read: if request.auth != null;
      // Note: User App logic creates these documents via client-side code in current implementation. 
      // STRICTLY speaking, the prompt says "User app must NOT update this after creation", 
      // but to CREATE it, we need 'create' permission or the Driver App won't get it 
      // (unless using Cloud Functions). 
      // For this pure client-side MVP from the prompt, we MUST allow create.
      allow create: if request.auth != null;
    }

    // Drivers: Allow reading for all authenticated users, writing only for owners
    match /drivers/{driverId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == driverId;
    }
    // Bus Schedules: Public read, locked writes
    // Helper function to check if user is an admin
    function isAdmin() {
      return request.auth != null && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
      );
    }

    // Admins Collection
    match /admins/{adminId} {
      // Allow all authenticated users to read to bypass list query exists() limits
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Admin Join Requests Collection
    match /admin_join_requests/{requestId} {
      allow create: if request.auth != null && request.auth.uid == requestId;
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Admin Managed Collections
    match /places/{placeId} {
      allow read: if true; // Might need public read later, keeping safe: isAdmin() or public? Public is fine.
      allow write: if isAdmin();
    }
    match /routes/{routeId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /buses/{busId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }
    match /bus_requests/{requestId} {
      allow read, write: if isAdmin();
    }

    // Bus Schedules: Public read, admin only writes
    match /bus_schedules/{scheduleId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
